{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seldon SDK lockfile",
  "type": "object",
  "required": ["version", "functions"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "seldon-lock-v1"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "functions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["function_id", "contract_digest"],
        "additionalProperties": false,
        "properties": {
          "function_id": {"type": "string", "format": "uuid"},
          "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "registered_at": {"type": "string", "format": "date-time"},
          "parts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
